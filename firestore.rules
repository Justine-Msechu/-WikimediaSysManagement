rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A deactivated account (Users → Deactivate, isActive == false) has no
    // role at all — blocked here, not only in the app's UI.
    function myRole() {
      return me().get("isActive", true) == false ? "disabled" : me().get("role", "");
    }

    function isAdmin() {
      return isAuth() && myRole() == "admin";
    }

    function isCoordinator() {
      return isAuth() && myRole() in ["admin", "coordinator"];
    }

    function isFinance() {
      return isAuth() && myRole() in ["admin", "finance_officer"];
    }

    function isAnyStaff() {
      return isAuth() && myRole() in ["admin", "coordinator", "finance_officer", "viewer"];
    }

    function isVolunteer() {
      return isAuth() && myRole() == "volunteer";
    }

    // Returns the volunteerId stored on the logged-in user's profile
    function myVolunteerId() {
      return me().get("volunteerId", "");
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Statuses a coordinator may set — approving / rejecting is for admin and finance.
    function coordinatorStatus() {
      return request.resource.data.get("status", "draft") in ["draft", "submitted"];
    }

    // ...or, on an update, leaving the status as it was (e.g. fixing a typo in
    // a rejected entry). Used together with "not approved yet".
    function coordinatorUpdateStatus() {
      return coordinatorStatus()
        || request.resource.data.get("status", "") == resource.data.get("status", "");
    }

    // A registration form that exists and isn't closed.
    function openForm(formId) {
      return exists(/databases/$(database)/documents/registrationForms/$(formId))
        && get(/databases/$(database)/documents/registrationForms/$(formId)).data.get("status", "open") != "closed";
    }

    function str(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // ── /users ─────────────────────────────────────────────────────────────
    // Admins manage all users. Each user can read their own document (so the
    // app can load role + profile on login). Only admins can write.
    match /users/{uid} {
      allow get:    if isAuth() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();
      allow create: if isAdmin();
      // Admins can update anything. Others may change only harmless fields of
      // their own doc — never role, isActive, email or volunteerId (a volunteer
      // changing volunteerId could open another volunteer's tasks).
      allow update: if isAdmin() ||
        (isAuth() && request.auth.uid == uid && myRole() != "disabled" &&
         changedOnly(["lastLogin", "name", "phone", "updatedAt"]));
      allow delete: if isAdmin();
    }

    // ── /settings ──────────────────────────────────────────────────────────
    // Grant config, org details, report answers. All staff read; only admins write.
    match /settings/{docId} {
      allow read:   if isAnyStaff();
      // isFinance() also covers admin. Needed because Settings → Payment details
      // is editable by admin or finance_officer in the app, and the budget importer
      // (admin/finance only) writes personnel rows here too.
      allow write:  if isFinance();
    }

    // ── /grants ────────────────────────────────────────────────────────────
    // Multi-grant registry. All staff read; only admins create/edit/delete.
    match /grants/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /metrics ───────────────────────────────────────────────────────────
    // Target vs result tracking. Coordinators and admins may edit; all staff read.
    match /metrics/{docId} {
      allow read:   if isAnyStaff();
      allow write:  if isCoordinator();
    }

    // ── /programs ──────────────────────────────────────────────────────────
    // Approved programs are locked — only admins can touch them.
    match /programs/{docId} {
      allow read:   if isAnyStaff() || isVolunteer();
      allow create: if isCoordinator();
      // A program locks once approved — only admins can edit it further, with
      // one exception: coordinators can still submit sub-program (session)
      // budgets for approval on an already-approved program, since sessions
      // get added and approved incrementally over the grant year. That's only
      // safe because it's restricted to touching just the subPrograms field.
      // Finance officers approve / return programs and sessions on Review
      // (status and approval fields, and the sessions inside subPrograms).
      // Coordinators can't approve their own program.
      allow update: if isAdmin() ||
        (isFinance() && changedOnly(["status", "approvedBy", "approvedAt", "rejectionComment", "rejectedAt", "subPrograms", "updatedAt"])) ||
        (isCoordinator() && resource.data.get("status", "draft") != "approved" && coordinatorUpdateStatus()) ||
        (isCoordinator() && resource.data.status == "approved" && changedOnly(["subPrograms", "updatedAt"]));
      allow delete: if isAdmin() ||
        (isCoordinator() && resource.data.status == "draft");
    }

    // ── /activities ────────────────────────────────────────────────────────
    match /activities/{docId} {
      allow read:   if isAnyStaff();
      allow write:  if isCoordinator();
    }

    // ── /evidence ──────────────────────────────────────────────────────────
    // Evidence links attached to activities (no file upload — Firestore only).
    match /evidence/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isCoordinator();
      allow delete: if isCoordinator();
      allow update: if isCoordinator();
    }

    // ── /participants ───────────────────────────────────────────────────────
    // Staff can create directly (e.g. manual entry or seed).
    // Public registration auto-writes here too — field validation prevents spam.
    match /participants/{docId} {
      allow read:   if isAnyStaff();
      // Public sign-ups: only the fields the registration page sends, short
      // values, and a real registration form that isn't closed.
      allow create: if isCoordinator()
                    || (request.resource.data.name is string
                        && request.resource.data.name.size() > 0
                        && request.resource.data.name.size() <= 300
                        && request.resource.data.formId is string
                        && request.resource.data.keys().hasOnly(["name", "wikimediaUsername", "email", "phone", "gender", "region", "isNew", "programId", "grantId", "source", "registeredViaForm", "formId", "createdAt", "updatedAt"])
                        && request.resource.data.get("source", "") == "self-registered"
                        && str("wikimediaUsername", 255) && str("email", 254) && str("phone", 40)
                        && str("programId", 128) && str("grantId", 128)
                        && openForm(request.resource.data.formId));
      allow update: if isCoordinator();
      allow delete: if isCoordinator();
    }

    // ── /registrationForms ─────────────────────────────────────────────────
    // Coordinators create and manage forms.
    // Public can read a specific form document (needed to render the public page).
    match /registrationForms/{formId} {
      allow get:    if true;          // public needs to load form definition
      allow list:   if isAnyStaff();
      allow create: if isCoordinator();
      // The public page adds 1 to registrationCount (so maxRegistrations works)
      // and may touch nothing else.
      allow update: if isCoordinator()
                    || (changedOnly(["registrationCount", "updatedAt"])
                        && request.resource.data.registrationCount == resource.data.get("registrationCount", 0) + 1);
      allow delete: if isCoordinator();
    }

    // ── /registrations ─────────────────────────────────────────────────────
    // Public submits registrations (no auth). Staff reads and marks attendance.
    // Field validation: name + formId required to block spam injection.
    match /registrations/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 300
                    && request.resource.data.formId is string
                    && (isCoordinator()
                        || (request.resource.data.keys().hasOnly(["name", "wikimediaUsername", "email", "phone", "age", "skills", "isNew", "programId", "grantId", "formId", "registeredAt", "attendance", "createdAt", "updatedAt"])
                            && request.resource.data.get("attendance", "") == ""
                            && str("wikimediaUsername", 255) && str("email", 254) && str("phone", 40)
                            && str("skills", 2000) && str("programId", 128) && str("grantId", 128)
                            && openForm(request.resource.data.formId)));
      allow read:   if isAnyStaff();
      allow update: if isCoordinator();  // attendance marking
      allow delete: if isAdmin();
    }

    // ── /budgetEntries ─────────────────────────────────────────────────────
    // Finance officers and admins approve. Coordinators create and edit draft /
    // submitted entries but can never approve or reject one, nor change an
    // approved entry (except moving it to its program's grant on Budget).
    match /budgetEntries/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isFinance() || (isCoordinator() && coordinatorStatus());
      allow update: if isFinance()
                    || (isCoordinator() && resource.data.get("status", "draft") != "approved" && coordinatorUpdateStatus())
                    || (isCoordinator() && changedOnly(["grantId", "updatedAt"]));
      allow delete: if isFinance();
    }

    // ── /invoices ──────────────────────────────────────────────────────────
    // Disbursement requests / invoices to fiscal sponsors and donors.
    // Money-movement records — restricted to Admin and Finance officer only,
    // unlike most other collections which Coordinators can also touch.
    match /invoices/{docId} {
      allow read:   if isAdmin() || isFinance();
      allow create: if isAdmin() || isFinance();
      allow update: if isAdmin() || isFinance();
      allow delete: if isAdmin() || isFinance();
    }

    // ── /risks ─────────────────────────────────────────────────────────────
    match /risks/{docId} {
      allow read:   if isAnyStaff();
      allow write:  if isCoordinator();
    }

    // ── /auditLogs ─────────────────────────────────────────────────────────
    // Any authenticated user (or the app itself) may append an audit record.
    // Only admins may read the log. Nobody deletes audit records.
    match /auditLogs/{docId} {
      // Records are written as yourself (no entries in someone else's name).
      allow create: if isAuth() && myRole() != "disabled"
                    && request.resource.data.get("userId", "") == request.auth.uid;
      allow read:   if isAdmin();
      allow update: if false;
      allow delete: if false;
    }

    // ── /pendingActivations ────────────────────────────────────────────────
    // Logged-in users without a Firestore profile write here so the admin
    // can see them and complete their account setup without Firebase console.
    match /pendingActivations/{uid} {
      allow create: if isAuth() && request.auth.uid == uid;
      allow read:   if isAuth() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── /notifications ─────────────────────────────────────────────────────────
    match /notifications/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff();
      allow update: if isAdmin() || (isAnyStaff() && changedOnly(["read", "updatedAt"]));
      allow delete: if isAdmin();
    }

    // ── /comments ──────────────────────────────────────────────────────────────
    // Viewers can post and read comments (their only write permission).
    match /comments/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /volunteers ────────────────────────────────────────────────────────────
    match /volunteers/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ── /communityMembers ──────────────────────────────────────────────────────
    // Active contributors module — same protection as /volunteers.
    match /communityMembers/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ── /contributorReports ────────────────────────────────────────────────────
    // Saved monthly reports, doc id "{wiki}_{YYYY-MM}" (+ "_events") — same protection as /volunteers.
    match /contributorReports/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ── /contributorEvents ─────────────────────────────────────────────────────
    // Kilimanjaro events (Outreach Dashboard courses) for "Kilimanjaro events only" counts.
    match /contributorEvents/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ── /volunteerTasks ────────────────────────────────────────────────────────
    match /volunteerTasks/{docId} {
      // Coordinators/admins manage all tasks.
      // Volunteers: list is restricted to their own volunteerId in the query.
      //   Firestore cannot enforce per-document filtering in list rules without
      //   get() (which is disallowed in list context), so the rule allows list
      //   for volunteers and the client always queries with the volunteerId filter.
      // For single-document get and update, we check volunteerId via get().
      allow list:   if isAnyStaff() || isVolunteer();
      allow get:    if isAnyStaff()
                    || (isVolunteer() && resource.data.volunteerId == myVolunteerId())
                    || (isVolunteer() && myVolunteerId() in resource.data.volunteerIds);
      allow create: if isCoordinator();
      // Support both old single-field (volunteerId) and new array (volunteerIds) format
      // Volunteers may only update progress on their own tasks (status, notes, hours).
      allow update: if isCoordinator()
        || (isVolunteer() && changedOnly(["status", "volunteerNotes", "hoursSpent", "updatedAt"])
            && (myVolunteerId() in resource.data.get("volunteerIds", [])
                || resource.data.get("volunteerId", "") == myVolunteerId()));
      allow delete: if isCoordinator();
    }

    // ── /announcements ─────────────────────────────────────────────────────────
    match /announcements/{docId} {
      allow read:   if isAnyStaff() || isVolunteer();
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if isAdmin();
    }

    // ── /deadlines ─────────────────────────────────────────────────────────────
    match /deadlines/{docId} {
      allow read:   if isAnyStaff() || isVolunteer();
      allow write:  if isCoordinator();
    }

    // ── /taskComments ──────────────────────────────────────────────────────────
    // Volunteers and all staff can read and post comments on tasks.
    match /taskComments/{docId} {
      allow read:   if isAnyStaff() || isVolunteer();
      allow create: if isAnyStaff() || isVolunteer();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── /activityTemplates ─────────────────────────────────────────────────────
    match /activityTemplates/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isCoordinator();
      allow update: if isCoordinator();
      allow delete: if isCoordinator();
    }

    // ── /activityFiles ─────────────────────────────────────────────────────────
    // Metadata for files uploaded to Google Drive and linked to an activity.
    // Any authenticated staff can read and add; coordinators and above can delete.
    match /activityFiles/{docId} {
      allow read:   if isAnyStaff();
      allow create: if isAnyStaff();
      allow delete: if isCoordinator();
      allow update: if false;   // records are immutable; delete and re-upload to replace
    }
  }
}
